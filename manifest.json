{
  "manifest_version": 3,
  "name": "RemiInstagramDownloader",
  "version": "0.1.0",
  "description": "Per-item Instagram downloads with independent saved settings, separate audio/video support and download verification.",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "offscreen",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://m.instagram.com/*"
      ],
      "js": [
        "page-observer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://m.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
